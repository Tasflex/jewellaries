# ---- site ----
SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@your-domain.com
# 0 hides the struck-through "compare at" price (use 0 unless it's a genuine sale/launch price)
NEXT_PUBLIC_SHOW_COMPARE_AT=1

# ---- api (Rust) ----
BIND=127.0.0.1:8300
API_URL=http://127.0.0.1:8300
DATABASE_PATH=/var/www/jewellaries/var/aurum.db
CATALOG_PATH=/var/www/jewellaries/data/catalog.json
DATA_DIR=/var/www/jewellaries/data
# long random string; protects /v1/admin/* (catalogue import, order queue)
ADMIN_TOKEN=change-me

# ---- payments: Paystack (cards + M-Pesa/mobile money; charges USD or KES) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=USD,KES

# ---- supplier: CJ Dropshipping (empty = dry-run) ----
CJ_API_KEY=
CJ_LOGISTIC=CJPacket Ordinary

# ---- optional: Supabase (reserved; project aurum-rosso-jewellery) ----
SUPABASE_URL=https://kjtulfyryqsnuqtkuhiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
